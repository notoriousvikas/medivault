# ==========================================
# MedTech AI Service - Environment Variables
# ==========================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=True

# Model Configuration
# Pretrained weights identifier from TorchXRayVision library
MODEL_NAME=densenet121-res224-all

# Device selection: "auto", "cpu", or "cuda"
# - "auto": automatically selects "cuda" if an NVIDIA GPU is available, otherwise "cpu"
# - "cpu": forces CPU inference
# - "cuda": forces GPU inference (e.g. Google Colab / CUDA-enabled server)
DEVICE=auto

# Startup Behavior
# Set to true to download/load model weights during application startup
# Set to false during unit tests or when running lightweight health checks
LOAD_MODEL_ON_STARTUP=true

# Upload Limits & Validation
# Maximum allowed file size in Megabytes (MB)
MAX_FILE_SIZE_MB=10

# Allowed file extensions (comma-separated)
ALLOWED_EXTENSIONS=.jpg,.jpeg,.png
